# Copie para `.env` (ao lado do docker-compose.yml) e preencha.
# O `.env` NÃO é versionado — a chave de integração é secreta.

# Backend do WebAge Hub. Ele roda no HOST (fora do Docker), porta 4601.
HUB_URL=http://host.docker.internal:4601

# Chave de integração DESTE sistema, criada no Hub:
#   Hub (http://localhost:4600) → Sistemas → Sistema Julia → chave de integração.
# Sem ela, a aba "IA" aparece como não configurada e nada é enviado ao Hub.
HUB_INTEGRATION_KEY=
